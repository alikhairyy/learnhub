# Copy this file to .env and fill in your values
PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/learnhub
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/learnhub

# Any long random string
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Set to "production" to serve the built React app from the server
NODE_ENV=development
